APP_NAME="SYNC SUS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://syncsus.local
APP_TIMEZONE=America/Fortaleza
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_STDERR_FORMATTER=\Monolog\Formatter\JsonFormatter

DB_CONNECTION=mysql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sync_sus
DB_USERNAME=sync_sus
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Ajustes opcionais para desenvolvimento local com DB_CONNECTION=sqlite:
# DB_BUSY_TIMEOUT=5000
# DB_JOURNAL_MODE=WAL
# DB_SYNCHRONOUS=NORMAL
# DB_TRANSACTION_MODE=DEFERRED

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
CACHE_STORE=failover
FILESYSTEM_DISK=local_private

REDIS_CLIENT=phpredis
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=syncsus-
REDIS_CONNECT_TIMEOUT=1
REDIS_READ_TIMEOUT=1
REDIS_MAX_RETRIES=1

MAIL_MAILER=log

SYNC_SUS_ADMIN_NAME=
SYNC_SUS_ADMIN_EMAIL=
SYNC_SUS_ADMIN_PASSWORD=
SYNC_SUS_ADMIN_ACCESS_CODE=ADMIN
SYNC_SUS_SEED_DEMO=false
SYNC_SUS_BACKUP_RETENTION_DAYS=14
SYNC_SUS_BACKUP_PATH=/var/www/html/storage/app/backups
SYNC_SUS_BACKUP_REQUIRE_ENCRYPTION=false
SYNC_SUS_BACKUP_ENCRYPTION_KEY_FILE=
SYNC_SUS_PANEL_POLL_SECONDS=2
SYNC_SUS_PANEL_HEARTBEAT_SECONDS=15
SYNC_SUS_QUEUE_POLL_SECONDS=5
SYNC_SUS_DASHBOARD_POLL_SECONDS=15
SYNC_SUS_PERFORMANCE_CACHE_ENABLED=true
SYNC_SUS_DASHBOARD_CACHE_SECONDS=3
SYNC_SUS_NAVIGATION_CACHE_SECONDS=60
SYNC_SUS_PANEL_CONFIGURATION_CACHE_SECONDS=60
SYNC_SUS_VITE_DEV_SERVER_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://[::1]:5173
SYNC_SUS_REQUIRE_HTTPS=true
SYNC_SUS_TRUSTED_HOSTS=
SYNC_SUS_TRUSTED_PROXIES=
SYNC_SUS_MAX_CONCURRENT_SESSIONS=1
SYNC_SUS_SYNCLAB_ENABLED=false
SYNC_SUS_SYNCLAB_BASE_URL=https://synclabweb.unisync.com.br
SYNC_SUS_SYNCLAB_UNIT_CODE=URGENCIA-CENTRAL
SYNC_SUS_SYNCLAB_CNES=6612547
SYNC_SUS_SYNCLAB_USERNAME=
SYNC_SUS_SYNCLAB_PASSWORD=
SYNC_SUS_SYNCLAB_QUEUE=integrations
SYNC_SUS_SYNCLAB_CONNECT_TIMEOUT=5
SYNC_SUS_SYNCLAB_TIMEOUT=30

# Nao defina PORT, RAILWAY_PUBLIC_DOMAIN ou RAILWAY_SERVICE_ID manualmente.
# O Railway injeta essas variaveis no container.

VITE_APP_NAME="${APP_NAME}"
