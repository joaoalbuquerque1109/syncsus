APP_NAME="SYNC SUS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://syncsus.local
APP_TIMEZONE=America/Fortaleza
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_STDERR_FORMATTER=\Monolog\Formatter\JsonFormatter

DB_CONNECTION=mysql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sync_sus
DB_USERNAME=sync_sus
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local_private

MAIL_MAILER=log

SYNC_SUS_ADMIN_NAME=
SYNC_SUS_ADMIN_EMAIL=
SYNC_SUS_ADMIN_PASSWORD=
SYNC_SUS_ADMIN_ACCESS_CODE=ADMIN
SYNC_SUS_SEED_DEMO=false
SYNC_SUS_BACKUP_RETENTION_DAYS=14
SYNC_SUS_BACKUP_PATH=/var/www/html/storage/app/backups
SYNC_SUS_BACKUP_REQUIRE_ENCRYPTION=false
SYNC_SUS_BACKUP_ENCRYPTION_KEY_FILE=
SYNC_SUS_PANEL_POLL_SECONDS=2
SYNC_SUS_DASHBOARD_POLL_SECONDS=15
SYNC_SUS_VITE_DEV_SERVER_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://[::1]:5173
SYNC_SUS_REQUIRE_HTTPS=true
SYNC_SUS_TRUSTED_HOSTS=
SYNC_SUS_TRUSTED_PROXIES=
SYNC_SUS_MAX_CONCURRENT_SESSIONS=1

# Nao defina PORT, RAILWAY_PUBLIC_DOMAIN ou RAILWAY_SERVICE_ID manualmente.
# O Railway injeta essas variaveis no container.

VITE_APP_NAME="${APP_NAME}"
