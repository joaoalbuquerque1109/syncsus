APP_NAME="SYNC HOSP"
APP_ENV=staging
APP_KEY=base64:v6idLvf5AKAm65IsO6Nw1U23/D6OM3+miJ+eBsuh3J0=
PATIENT_IDENTIFIER_HMAC_KEY=2158a665c70fd6241b0221f1c61e313e
PATIENT_IDENTIFIER_HMAC_KEY_VERSION=1
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=America/Fortaleza
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_STDERR_FORMATTER=\Monolog\Formatter\JsonFormatter

DB_CONNECTION=mysql
DB_URL=
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sync_sus
DB_USERNAME=sync_sus
DB_PASSWORD=LoadTest123!
DB_ROOT_PASSWORD=LoadTestRoot123!
# Sessão MySQL alinhada com APP_TIMEZONE (America/Fortaleza, sem horário de verão no
# Brasil). Sem isso, colunas TIMESTAMP interpretam/gravam com o time_zone padrão do
# servidor (UTC), gerando um desvio de 3h entre o que a aplicação grava e o valor real.
DB_TIMEZONE=-03:00

# Infraestrutura compartilhada pertence ao Core, nunca ao banco da unidade ativa.
SESSION_CONNECTION=core
DB_QUEUE_CONNECTION=core
DB_CACHE_CONNECTION=core
DB_CACHE_LOCK_CONNECTION=core

# Fase 3: perfis de conexão para bancos físicos por unidade. Segredos devem vir
# do gerenciador de segredos da plataforma; nunca são persistidos no Core.
TENANT_LEGACY_CONNECTION=mysql
TENANT_DATABASE_PROFILES={}

# Fase 7: configuração não secreta compartilhada com a aplicação web. O host da conta
# deve ser explícito; '%' é recusado. As credenciais TENANT_PROVISIONING_* pertencem
# somente ao ambiente separado do worker e não devem existir neste arquivo/processo web.
TENANT_PROVISIONING_QUEUE=tenant-provisioning
TENANT_PROVISIONING_WORKER=false
TENANT_AUTOMATIC_CUTOVER=false
TENANT_PROVISIONING_EXPECTED_PARTIAL_REVOKES=
TENANT_PROVISIONING_REQUIRE_TLS=true
TENANT_RUNTIME_ACCOUNT_HOST=
TENANT_RUNTIME_DB_HOST=
TENANT_RUNTIME_DB_PORT=3306
TENANT_RUNTIME_SSL_CA=

# Ajustes opcionais para desenvolvimento local com DB_CONNECTION=sqlite:
# DB_BUSY_TIMEOUT=5000
# DB_JOURNAL_MODE=WAL
# DB_SYNCHRONOUS=NORMAL
# DB_TRANSACTION_MODE=DEFERRED

# Sessão e fila em Redis ficam para depois: ResetUserPasswordAction,
# ChangePasswordAction, LimitConcurrentSessions e UserManagementController
# derrubam sessão de usuário via DB::connection(config('session.connection'))
# ->table('sessions') — só funciona com sessão em tabela SQL. Trocar
# SESSION_DRIVER para redis sem reescrever esses quatro pontos quebra
# reset/troca de senha, desativação de usuário e limite de sessões
# concorrentes. O painel de Operações também lê "pendingJobs" direto da
# tabela jobs do Core; com fila em Redis esse número ficaria sempre
# ~zero, silenciosamente errado. As conexões Redis 'session'/'queue' já
# existem em config/database.php para quando isso for reescrito.
SESSION_DRIVER=database
SESSION_CONNECTION=core
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
CACHE_STORE=failover
FILESYSTEM_DISK=local_private

REDIS_CLIENT=phpredis
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_PREFIX=syncsus-
REDIS_CONNECT_TIMEOUT=1
REDIS_READ_TIMEOUT=1
REDIS_MAX_RETRIES=1

MAIL_MAILER=log

SYNC_SUS_ADMIN_NAME="Administrador Loadtest"
SYNC_SUS_ADMIN_EMAIL=admin@loadtest.local
SYNC_SUS_ADMIN_PASSWORD="LoadTest#Admin123"
SYNC_SUS_ADMIN_ACCESS_CODE=ADMIN
SYNC_SUS_SEED_DEMO=true
SYNC_SUS_BACKUP_RETENTION_DAYS=14
SYNC_SUS_BACKUP_PATH=/var/www/html/storage/app/backups
SYNC_SUS_BACKUP_REQUIRE_ENCRYPTION=false
SYNC_SUS_BACKUP_ENCRYPTION_KEY_FILE=
SYNC_SUS_PANEL_POLL_SECONDS=2
SYNC_SUS_PANEL_HEARTBEAT_SECONDS=15
SYNC_SUS_QUEUE_POLL_SECONDS=5
SYNC_SUS_DASHBOARD_POLL_SECONDS=15
SYNC_SUS_PERFORMANCE_CACHE_ENABLED=true
SYNC_SUS_DASHBOARD_CACHE_SECONDS=3
SYNC_SUS_NAVIGATION_CACHE_SECONDS=60
SYNC_SUS_PANEL_CONFIGURATION_CACHE_SECONDS=60
SYNC_SUS_VITE_DEV_SERVER_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://[::1]:5173
SYNC_SUS_REQUIRE_HTTPS=false
SYNC_SUS_TRUSTED_HOSTS=localhost,127.0.0.1,nginx
SYNC_SUS_TRUSTED_PROXIES=
SYNC_SUS_MAX_CONCURRENT_SESSIONS=1
SYNC_SUS_SYNCLAB_ENABLED=false
SYNC_SUS_SYNCLAB_PUBLIC_IDENTIFIERS_ENABLED=false
SYNC_SUS_SYNCLAB_RESULTS_ENABLED=false
# Só ligue depois que o Synclab confirmar que passa a assinar o corpo com
# X-Synclab-Result-Signature (HMAC-SHA256 usando o mesmo token). Antes disso,
# ligar isso derruba a recepção real de resultado.
SYNC_SUS_SYNCLAB_REQUIRE_RESULT_SIGNATURE=false
SYNC_SUS_SYNCLAB_BASE_URL=https://synclabweb.unisync.com.br
SYNC_SUS_SYNCLAB_UNIT_CODE=URGENCIA-CENTRAL
SYNC_SUS_SYNCLAB_CNES=6612547
SYNC_SUS_SYNCLAB_USERNAME=
SYNC_SUS_SYNCLAB_PASSWORD=
SYNC_SUS_SYNCLAB_QUEUE=integrations
SYNC_SUS_SYNCLAB_CONNECT_TIMEOUT=5
SYNC_SUS_SYNCLAB_TIMEOUT=30

# Nao defina PORT, RAILWAY_PUBLIC_DOMAIN ou RAILWAY_SERVICE_ID manualmente.
# O Railway injeta essas variaveis no container.

VITE_APP_NAME="${APP_NAME}"
